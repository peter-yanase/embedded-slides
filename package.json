{
    "name": "embedded-slides",
    "version": "0.9.0",
    "description": "Create slides directly inside your notes.",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "eslint ."
    },
    "keywords": [
        "presentation",
        "slides"
    ],
    "author": "Peter Yanase",
    "license": "PolyForm Perimeter v1.0.1",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.4.1",
        "esbuild": "0.28.2",
        "eslint-plugin-obsidianmd": "0.4.2",
        "globals": "17.12.0",
        "jiti": "2.7.0",
        "obsidian": "1.13.1",
        "reveal.js": "6.0.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.69.0"
    }
}
